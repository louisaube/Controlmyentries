run = "uvicorn api.main:app --host 0.0.0.0 --port 8080"
entrypoint = "api/main.py"
modules = ["python-3.11", "nodejs-20", "bash"]

[nix]
channel = "stable-25_05"
packages = ["libiconv", "libxcrypt", "pkg-config", "xsimd"]

[deployment]
run = ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port 8080"]

[env]
PYTHONPATH = "${REPL_HOME}"

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000
